---
// La courbe jour par jour, en SVG rendu au build : tâches prévues, tâches faites, rythme pour finir à temps.
import { DAY, Project, type Issue } from "../lib/model";
import { dayLong, dayShort } from "../lib/format";

interface Props { project: Project; list: Issue[]; due: Date | null; now: Date; id: string; hidden?: boolean }
const { project, list, due, now, id, hidden = false } = Astro.props;

const W = 620, H = 260, L = 34, R = 16, T = 18, B = 30;
const pts = project.burnup(list, now);
const start = pts[0]?.day ?? now;
const end = new Date(Math.max(+now, due ? +due : 0) + DAY);
const x = (d: Date) => L + (W - L - R) * ((+d - +start) / (+end - +start));
const ymax = Math.max(4, list.length);
const y = (v: number) => T + (H - T - B) * (1 - v / ymax);
const line = (f: (p: (typeof pts)[number]) => number) => pts.map((p, k) => `${k ? "L" : "M"}${x(p.day).toFixed(1)},${y(f(p)).toFixed(1)}`).join("");
const last = pts.at(-1) ?? { scope: 0, done: 0 };
const area = `${line((p) => p.done)}L${x(now).toFixed(1)},${y(0)}L${x(start).toFixed(1)},${y(0)}Z`;
const step = Math.max(1, Math.ceil(ymax / 4));
const yTicks = Array.from({ length: Math.floor(ymax / step) + 1 }, (_, k) => k * step);
const xTicks: Date[] = [];
for (let d = new Date(start); d <= end; d = new Date(+d + 7 * DAY)) xTicks.push(d);
const late = due && due > now;
---
<div id={id} hidden={hidden}>
  <svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-labelledby={`${id}-t ${id}-d`} style="display:block;overflow:visible">
    <title id={`${id}-t`}>Tâches prévues et tâches faites, jour par jour</title>
    <desc id={`${id}-d`}>Aujourd'hui, {last.done} faites sur {last.scope}.{due && ` Échéance le ${dayLong(due)}.`}</desc>
    {yTicks.map((v) => (
      <>
        <line x1={L} x2={W - R} y1={y(v)} y2={y(v)} stroke="#D5DAE3" stroke-width="1" />
        <text x={L - 8} y={y(v) + 4} text-anchor="end" font-size="11" fill="#596579">{v}</text>
      </>
    ))}
    {xTicks.map((d) => <text x={x(d)} y={H - 8} text-anchor="middle" font-size="11" fill="#596579">{dayShort(d)}</text>)}
    <path d={area} fill="rgba(27,39,71,.10)" />
    <path d={line((p) => p.scope)} fill="none" stroke="#596579" stroke-width="2" />
    <path d={line((p) => p.done)} fill="none" stroke="#1B2747" stroke-width="3" stroke-linejoin="round" />
    {late && due && (
      <>
        <line x1={x(now)} y1={y(last.done)} x2={x(due)} y2={y(last.scope)} stroke="#E83E1B" stroke-width="2" stroke-dasharray="5 5" />
        <line x1={x(due)} x2={x(due)} y1={T - 6} y2={H - B} stroke="#E83E1B" stroke-width="2" />
        <text x={x(due) - 6} y={T + 4} text-anchor="end" font-size="12" font-weight="700" fill="#C53215">échéance {dayShort(due)}</text>
      </>
    )}
    <line x1={x(now)} x2={x(now)} y1={T} y2={H - B} stroke="#1B2747" stroke-width="1" stroke-dasharray="2 3" />
    <text x={x(now) + 6} y={H - B - 6} font-size="11" font-weight="700" fill="#1B2747">aujourd'hui</text>
    <circle cx={x(now)} cy={y(last.done)} r="5" fill="#1B2747" stroke="#fff" stroke-width="2" />
  </svg>
  <ul class="legend" style="margin-top:4px">
    <li style="--c:#596579">tâches prévues</li>
    <li style="--c:#1B2747">tâches faites</li>
    {late && <li style="--c:#E83E1B">rythme pour finir à temps</li>}
  </ul>
</div>
